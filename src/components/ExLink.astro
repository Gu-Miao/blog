---
export interface ExLinkProps {
  href: string
}

const { href } = Astro.props as ExLinkProps
const external = /^https?:\/\//i.test(href)
---

{
  external ? (
    <a href={href} target="_blank" rel="external nofollow noopener noreferrer">
      <slot />
    </a>
  ) : (
    <a href={href}>
      <slot />
    </a>
  )
}
